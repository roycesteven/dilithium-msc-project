diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index ad18115..585b33c 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -58,6 +58,42 @@ if(ENABLE_IPC)
   add_subdirectory(ipc)
 endif()
 
+# --- LAS post-quantum signature verification, as a consensus rule ------------------
+# The scheme itself is the project's reference C implementation, vendored unmodified; the
+# only new code is las_consensus.c, a thin wrapper that expands the fixed public parameters
+# once and calls base_verify_packed. Building it as its own C library keeps it out of the
+# C++ translation units (the ref headers use C11 _Static_assert wire-size anchors) and
+# makes it obvious in the build graph that consensus now depends on it.
+#
+# randombytes_abort.c REPLACES the reference randombytes: a consensus build must never draw
+# entropy, since two nodes disagreeing on randomness would disagree on validity. It aborts
+# instead, so a mistake is a crash rather than a chain split.
+add_library(bitcoin_las STATIC EXCLUDE_FROM_ALL
+  script/las/las_consensus.c
+  script/las/randombytes_abort.c
+  script/las/basesig.c
+  script/las/serialize.c
+  script/las/setup.c
+  script/las/relation.c
+  script/las/las.c
+  script/las/poly.c
+  script/las/polyvec.c
+  script/las/ntt.c
+  script/las/reduce.c
+  script/las/rounding.c
+  script/las/fips202.c
+  script/las/symmetric-shake.c
+  script/las/packing.c
+  script/las/sign.c
+)
+target_include_directories(bitcoin_las PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/script/las)
+# D3 (n=6, ell=5, kappa=49): the project's headline parameter set, matching
+# ref/serialize.h's static wire-size assertions and every other measurement.
+target_compile_definitions(bitcoin_las PRIVATE DILITHIUM_MODE=3 LAS_N=6 ELL=5 KAPPA=49)
+target_compile_options(bitcoin_las PRIVATE -w)
+find_package(Threads REQUIRED)
+target_link_libraries(bitcoin_las PRIVATE Threads::Threads)
+
 add_library(bitcoin_consensus STATIC EXCLUDE_FROM_ALL
   arith_uint256.cpp
   consensus/merkle.cpp
@@ -76,6 +112,7 @@ target_link_libraries(bitcoin_consensus
     core_interface
     bitcoin_crypto
     secp256k1
+    bitcoin_las
 )
 
 if(WITH_ZMQ)
diff --git a/src/script/interpreter.cpp b/src/script/interpreter.cpp
index 443714c..db12781 100644
--- a/src/script/interpreter.cpp
+++ b/src/script/interpreter.cpp
@@ -4,6 +4,7 @@
 // file COPYING or http://www.opensource.org/licenses/mit-license.php.
 
 #include <script/interpreter.h>
+#include <script/las_consensus.h>
 
 #include <crypto/ripemd160.h>
 #include <crypto/sha1.h>
@@ -1102,6 +1103,82 @@ bool EvalScript(std::vector<std::vector<unsigned char> >& stack, const CScript&
                 }
                 break;
 
+
+                case OP_CHECKLASSIGVERIFY:
+                {
+                    // Post-quantum signature verification (LAS, eprint 2020/845).
+                    //
+                    // Tapscript only: this opcode occupies a BIP342 OP_SUCCESSx slot, which
+                    // has no meaning outside tapscript.
+                    if (sigversion != SigVersion::TAPSCRIPT) return set_error(serror, SCRIPT_ERR_BAD_OPCODE);
+
+                    // WHY THE OPERANDS ARE CHUNKED. A LAS signature is 6,736 bytes and a
+                    // public key 4,416; a witness stack element is limited to
+                    // MAX_SCRIPT_ELEMENT_SIZE (520) by consensus, and that limit is applied
+                    // to the INITIAL witness stack in ExecuteWitnessScript. So neither
+                    // object can arrive as one element. Rather than raise a consensus limit
+                    // for one opcode -- a far larger change, affecting every script -- the
+                    // opcode reassembles a fixed number of fixed-length chunks. The
+                    // fixed-length requirement is what stops a short chunk shifting the
+                    // reconstruction to produce a different message.
+                    const size_t sig_bytes = LASConsensusSigBytes();
+                    const size_t pk_bytes = LASConsensusPkBytes();
+                    const size_t n_sig = (sig_bytes + MAX_SCRIPT_ELEMENT_SIZE - 1) / MAX_SCRIPT_ELEMENT_SIZE;
+                    const size_t n_pk = (pk_bytes + MAX_SCRIPT_ELEMENT_SIZE - 1) / MAX_SCRIPT_ELEMENT_SIZE;
+
+                    // Stack, top to bottom:
+                    //   sha256(pk)  |  pk_n .. pk_1  |  sig_n .. sig_1
+                    // The commitment is pushed by the leaf script itself; the chunks come
+                    // from the witness, in byte order bottom-to-top.
+                    if (stack.size() < 1 + n_pk + n_sig) return set_error(serror, SCRIPT_ERR_INVALID_STACK_OPERATION);
+
+                    const valtype& commitment = stacktop(-1);
+                    if (commitment.size() != 32) return set_error(serror, SCRIPT_ERR_LAS_MALFORMED);
+
+                    // Sigops budget. A LAS verification is charged as one tapscript sigop,
+                    // exactly as a Schnorr check is. NOTE this is a demonstration choice,
+                    // not a costing: the relative validation cost of the two is not analysed
+                    // by this project, and a real deployment would have to price it.
+                    assert(execdata.m_validation_weight_left_init);
+                    execdata.m_validation_weight_left -= VALIDATION_WEIGHT_PER_SIGOP_PASSED;
+                    if (execdata.m_validation_weight_left < 0) return set_error(serror, SCRIPT_ERR_TAPSCRIPT_VALIDATION_WEIGHT);
+
+                    // Reassemble, checking every chunk length exactly.
+                    auto gather = [&](size_t first_from_top, size_t count, size_t total, std::vector<unsigned char>& out) -> bool {
+                        out.clear();
+                        out.reserve(total);
+                        for (size_t i = 0; i < count; ++i) {
+                            // chunk index i (0-based, byte order) sits at depth
+                            // first_from_top + (count - 1 - i) from the top.
+                            const valtype& c = stacktop(-(int)(first_from_top + (count - 1 - i)));
+                            const size_t remaining = total - out.size();
+                            const size_t want = remaining > (size_t)MAX_SCRIPT_ELEMENT_SIZE ? (size_t)MAX_SCRIPT_ELEMENT_SIZE : remaining;
+                            if (c.size() != want) return false;
+                            out.insert(out.end(), c.begin(), c.end());
+                        }
+                        return out.size() == total;
+                    };
+
+                    std::vector<unsigned char> pk_full, sig_full;
+                    if (!gather(2, n_pk, pk_bytes, pk_full)) return set_error(serror, SCRIPT_ERR_LAS_MALFORMED);
+                    if (!gather(2 + n_pk, n_sig, sig_bytes, sig_full)) return set_error(serror, SCRIPT_ERR_LAS_MALFORMED);
+
+                    // The output commits to a HASH of the public key, which is only revealed
+                    // at spending time -- the same discipline as P2WSH, and the reason a
+                    // 4,416-byte key costs nothing until the coin is actually spent.
+                    unsigned char pkhash[32];
+                    CSHA256().Write(pk_full.data(), pk_full.size()).Finalize(pkhash);
+                    if (memcmp(pkhash, commitment.data(), 32) != 0) return set_error(serror, SCRIPT_ERR_LAS_PUBKEY_COMMITMENT);
+
+                    if (!checker.CheckLASSignature(sig_full, pk_full, sigversion, execdata, serror)) return false;
+
+                    // VERIFY semantics: consume the operands, push nothing. The leaf script
+                    // therefore ends with a truthy push, as tapscript's cleanstack rule
+                    // requires.
+                    for (size_t i = 0; i < 1 + n_pk + n_sig; ++i) popstack(stack);
+                }
+                break;
+
                 case OP_CHECKMULTISIG:
                 case OP_CHECKMULTISIGVERIFY:
                 {
@@ -1825,6 +1902,31 @@ bool GenericTransactionSignatureChecker<T>::CheckSequence(const CScriptNum& nSeq
     return true;
 }
 
+
+template <class T>
+bool GenericTransactionSignatureChecker<T>::CheckLASSignature(std::span<const unsigned char> sig, std::span<const unsigned char> pubkey, SigVersion sigversion, ScriptExecutionData& execdata, ScriptError* serror) const
+{
+    assert(sigversion == SigVersion::TAPSCRIPT);
+
+    // SIGHASH_DEFAULT ONLY. BIP341's other sighash types narrow what the signature commits
+    // to -- SIGHASH_NONE drops the outputs, SIGHASH_SINGLE all but one, ANYONECANPAY the
+    // other inputs. A post-quantum signature whose transaction binding could be narrowed
+    // that way would authorise a payment its signer never saw, so this rule fixes the
+    // strongest form and refuses to encode a type byte at all.
+    uint256 sighash;
+    if (!this->txdata) return HandleMissingData(m_mdb);
+    if (!SignatureHashSchnorr(sighash, execdata, *txTo, nIn, SIGHASH_DEFAULT, sigversion, *this->txdata, m_mdb)) {
+        return set_error(serror, SCRIPT_ERR_LAS_SIG);
+    }
+
+    // The predicate itself is ref/basesig.c's base_verify_packed, reached through the
+    // consensus shim. The node holds no second implementation of the scheme.
+    if (LASConsensusVerify(sig.data(), sig.size(), pubkey.data(), pubkey.size(), sighash.begin(), 32) != 1) {
+        return set_error(serror, SCRIPT_ERR_LAS_SIG);
+    }
+    return true;
+}
+
 // explicit instantiation
 template class GenericTransactionSignatureChecker<CTransaction>;
 template class GenericTransactionSignatureChecker<CMutableTransaction>;
