@@ -364,10 +365,14 @@ bool GetScriptOp(CScriptBase::const_iterator& pc, CScriptBase::const_iterator en
 
 bool IsOpSuccess(const opcodetype& opcode)
 {
+    // 0xbb (187) is NO LONGER an OP_SUCCESS: it is OP_CHECKLASSIGVERIFY. This is the
+    // whole soft-fork mechanism -- BIP342 reserves OP_SUCCESSx precisely so a future
+    // rule can give one a meaning, and a script using it stops succeeding
+    // unconditionally and starts having to satisfy that rule.
     return opcode == 80 || opcode == 98 || (opcode >= 126 && opcode <= 129) ||
            (opcode >= 131 && opcode <= 134) || (opcode >= 137 && opcode <= 138) ||
            (opcode >= 141 && opcode <= 142) || (opcode >= 149 && opcode <= 153) ||
-           (opcode >= 187 && opcode <= 254);
+           (opcode >= 188 && opcode <= 254);
 }
 
 bool CheckMinimalPush(const std::vector<unsigned char>& data, opcodetype opcode) {
