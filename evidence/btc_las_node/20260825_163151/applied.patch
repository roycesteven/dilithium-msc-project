+                                                const poly v[ELL]) {
+  unsigned int i;
+  poly t;
+
+  poly_pointwise_montgomery(w, &u[0], &v[0]);
+  for(i = 1; i < ELL; ++i) {
+    poly_pointwise_montgomery(&t, &u[i], &v[i]);
+    poly_add(w, w, &t);
+  }
