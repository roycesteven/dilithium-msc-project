{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/update_claude_context.py\" --hook session-start",
            "timeout": 30,
            "statusMessage": "Refreshing CLAUDE.md live project state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/update_claude_context.py\" --hook stop",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
