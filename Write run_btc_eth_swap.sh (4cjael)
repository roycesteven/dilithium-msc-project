  echo
  echo "SCOPE: the settlement path plus the Bitcoin refund branch. A patched node is not"
  echo "Bitcoin; the consensus rule's security is unanalysed; regtest and anvil are not"
  echo "mainnets; the two sides' security levels are unmatched."
} | tee -a "$OUT/verdict.txt"

